<style>
    #dynamicNavbar {
        position: fixed;
        top: 0;
        width: 100%;
        background: transparent;
        color: var(--text-light);
        transition: all 0.4s ease;
        z-index: 999;
        padding: 1rem 2rem;
        display: flex;
        justify-content: center;
    }

    #dynamicNavbar.scrolled {
        background: var(--bg-dark);
        padding: 0.4rem 2rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    }

    #dynamicNavbar .navbar-nav {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2rem;
    }

    #dynamicNavbar .nav-link {
        color: #FFFFFF; /* Tous les textes blancs */
        display: flex;
        align-items: center;
        transition: 0.3s ease;
    }

    #dynamicNavbar .nav-link .nav-text {
        margin-left: 0.5rem;
        transition: opacity 0.3s ease;
    }

    #dynamicNavbar.scrolled .nav-text {
        opacity: 0;
        width: 0;
        overflow: hidden;
    }

    #dynamicNavbar .navbar-brand .brand-text {
        margin-left: 0.5rem;
        color: var(--accent); /* Nom de l’app accentué */
        font-weight: bold;
        transition: opacity 0.3s ease;
    }

    #dynamicNavbar.scrolled .brand-text {
        opacity: 0;
        width: 0;
        overflow: hidden;
    }

    /* Hover effets icônes */
    #dynamicNavbar .nav-link:hover {
        color: var(--accent);
    }

</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const navbar = document.getElementById('dynamicNavbar');
        let lastScroll = 0;

        window.addEventListener('scroll', () => {
            const currentScroll = window.pageYOffset;

            if(currentScroll > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }

            lastScroll = currentScroll;
        });
    });
</script>
