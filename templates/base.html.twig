{% block javascripts %}
    <script>
        // Gestion des favoris
        document.addEventListener('DOMContentLoaded', () => {
            // Toggle favoris
            document.addEventListener('click', async (e) => {
                const btn = e.target.closest('.js-toggle-favorite');
                if (!btn) return;

                e.preventDefault();
                e.stopPropagation();

                const tmdbId = btn.dataset.tmdbId;
                if (!tmdbId) return;

                const icon = btn.querySelector('i');
                const originalClass = icon.className;

                try {
                    // Animation
                    btn.disabled = true;
                    icon.className = 'bi bi-hourglass-split';

                    const response = await fetch(`/favorites/toggle/${tmdbId}`, {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const data = await response.json();

                    if (!response.ok) {
                        if (data.redirect) {
                            window.location.href = data.redirect;
                            return;
                        }
                        throw new Error(data.message || 'Erreur');
                    }

                    // Mettre à jour l'icône
                    if (data.action === 'added') {
                        icon.className = 'bi bi-heart-fill';
                        btn.classList.remove('btn-light');
                        btn.classList.add('btn-danger');
                        showToast('Ajouté aux favoris', 'success');
                    } else {
                        icon.className = 'bi bi-heart';
                        btn.classList.remove('btn-danger');
                        btn.classList.add('btn-light');
                        showToast('Retiré des favoris', 'info');

                        // Si on est sur la page favoris, retirer la carte
                        if (window.location.pathname.includes('/favorites')) {
                            btn.closest('.col-6').remove();
                        }
                    }

                } catch (error) {
                    console.error('Erreur:', error);
                    icon.className = originalClass;
                    showToast('Une erreur est survenue', 'danger');
                } finally {
                    btn.disabled = false;
                }
            });

            // Charger l'état des favoris sur les cartes
            async function loadFavoriteStates() {
                const buttons = document.querySelectorAll('.js-toggle-favorite');
                const tmdbIds = [...buttons].map(btn => btn.dataset.tmdbId).filter(Boolean);

                if (tmdbIds.length === 0) return;

                try {
                    for (const tmdbId of tmdbIds) {
                        const response = await fetch(`/favorites/check/${tmdbId}`);
                        const data = await response.json();

                        const btn = document.querySelector(`.js-toggle-favorite[data-tmdb-id="${tmdbId}"]`);
                        if (!btn) continue;

                        const icon = btn.querySelector('i');
                        if (data.is_favorite) {
                            icon.className = 'bi bi-heart-fill';
                            btn.classList.remove('btn-light');
                            btn.classList.add('btn-danger');
                        } else {
                            icon.className = 'bi bi-heart';
                            btn.classList.remove('btn-danger');
                            btn.classList.add('btn-light');
                        }
                    }
                } catch (error) {
                    console.error('Erreur chargement favoris:', error);
                }
            }

            // Charger au démarrage
            loadFavoriteStates();
        });

        // Toast notifications
        function showToast(message, type = 'info') {
            const toastContainer = document.getElementById('toast-container') || createToastContainer();

            const toast = document.createElement('div');
            toast.className = `toast align-items-center text-white bg-${type} border-0`;
            toast.setAttribute('role', 'alert');
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            `;

            toastContainer.appendChild(toast);
            const bsToast = new bootstrap.Toast(toast, { delay: 3000 });
            bsToast.show();

            toast.addEventListener('hidden.bs.toast', () => toast.remove());
        }

        function createToastContainer() {
            const container = document.createElement('div');
            container.id = 'toast-container';
            container.className = 'toast-container position-fixed top-0 end-0 p-3';
            container.style.zIndex = '9999';
            document.body.appendChild(container);
            return container;
        }
    </script>
{% endblock %}