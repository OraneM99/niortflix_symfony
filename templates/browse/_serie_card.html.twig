<div class="col-6 col-md-4 col-lg-2">
    <div class="card h-100 shadow-sm hover-scale position-relative">

        {% if serie.tmdb_id is defined and serie.tmdb_id %}

            <a href="{{ path('browse_detail', {tmdbId: serie.tmdb_id}) }}"
               class="text-decoration-none serie-card-link js-open-detail"
               data-tmdb-id="{{ serie.tmdb_id }}">

                {# Poster #}
                {% if serie.poster %}
                    <img src="{{ serie.poster }}"
                         class="card-img-top"
                         alt="{{ serie.name }}"
                         loading="lazy"
                         style="height: 300px; object-fit: cover;">
                {% else %}
                    <div class="bg-secondary d-flex align-items-center justify-content-center"
                         style="height: 300px;">
                        <i class="bi bi-film fs-1 text-white-50"></i>
                    </div>
                {% endif %}

                {# Infos #}
                <div class="card-body p-2">
                    <h6 class="card-title text-truncate mb-1" title="{{ serie.name }}">
                        {{ serie.name }}
                    </h6>

                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                            {% if serie.vote %}
                                <i class="bi bi-star-fill text-warning"></i>
                                {{ serie.vote|number_format(1) }}
                            {% endif %}
                        </small>

                        {% if serie.year %}
                            <small class="text-muted">{{ serie.year }}</small>
                        {% endif %}
                    </div>
                </div>
            </a>

            {# Bouton favoris #}
            {% if app.user %}
                <div class="position-absolute top-0 start-0 m-2">
                    <button class="btn btn-sm btn-light rounded-circle js-toggle-favorite"
                            data-tmdb-id="{{ serie.tmdb_id }}"
                            title="Ajouter aux favoris">
                        <i class="bi bi-heart"></i>
                    </button>
                </div>
            {% endif %}

        {% endif %}
    </div>
</div>